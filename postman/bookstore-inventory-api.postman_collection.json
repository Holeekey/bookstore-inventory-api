              "body": "{\n  \"value\": {\n    \"id\": 1,\n    \"title\": \"The Pragmatic Programmer\",\n    \"author\": \"David Thomas\",\n    \"isbn\": \"978-0135957059\",\n    \"costUsd\": 34.99,\n    \"sellingPriceLocal\": null,\n    \"stockQuantity\": 12,\n    \"category\": \"Software Engineering\",\n    \"supplierCountry\": \"US\",\n    \"createdAt\": \"2026-08-01T12:00:00.000Z\",\n    \"updatedAt\": \"2026-08-01T12:00:00.000Z\"\n  }\n}"
