{
  "info": {
    "name": "Bookstore Inventory API",
    "description": "Colección Postman para API de inventario de librería.\n\nContrato de respuesta:\n- Éxito: el cuerpo es el valor devuelto por el caso de uso, sin envoltorio.\n- Error: `{ \"code\": \"...\", \"message\": \"...\" }` con el status HTTP correspondiente. Los errores de dominio traen su código (`BOOK-E-XXX`); los de infraestructura o validación, un código genérico (`BAD_REQUEST`, `NOT_FOUND`, `INTERNAL_ERROR`).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "b00k5t0r3-1nv3nt0ry-4p1-0001"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string",
      "description": "URL base de la API. El puerto se define por la variable de entorno PORT (por defecto 3000, ver src/main.ts)."
    },
    {
      "key": "bookId",
      "value": "1",
      "type": "string",
      "description": "Id numérico de un libro."
    }
  ],
  "item": [
    {
      "name": "Books",
      "description": "Endpoints del recurso Book.",
      "item": [
        {
          "name": "Create book",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"The Pragmatic Programmer\",\n  \"author\": \"David Thomas\",\n  \"isbn\": \"978-0135957059\",\n  \"costUsd\": 34.99,\n  \"stockQuantity\": 12,\n  \"category\": \"Software Engineering\",\n  \"supplierCountry\": \"US\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            },
            "description": "Crea un libro. Devuelve el id asignado."
          },
          "response": [
            {
              "name": "201 Created",
              "originalRequest": {
