// Prisma schema for the bookstore inventory API.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Book {
  id                Int      @id @default(autoincrement())
  title             String   @db.VarChar(255)
  author            String   @db.VarChar(255)
  isbn              String   @unique @db.VarChar(20)
  costUsd           Decimal  @map("cost_usd") @db.Decimal(10, 2)
  sellingPriceLocal Decimal? @map("selling_price_local") @db.Decimal(12, 2)
  stockQuantity     Int      @map("stock_quantity")
  category          String   @db.VarChar(120)
  supplierCountry   String   @map("supplier_country") @db.VarChar(2)
  createdAt         DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @map("updated_at") @db.Timestamptz(3)

  @@index([category])
  @@index([stockQuantity])
  @@map("books")
}
